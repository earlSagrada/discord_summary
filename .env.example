# ── 复制本文件为 .env，填入你自己的 key。.env 已被 .gitignore 忽略，不会提交 ──

# Claude（图片转写 + 日报）；国内直连不通时再设代理
ANTHROPIC_API_KEY=
# HTTPS_PROXY=http://127.0.0.1:7890

# 财报日历 + consensus/actual（免费 key，60 req/min，性价比最高）
FINNHUB_API_KEY=

# Financial Modeling Prep：财报日历 + estimates（免费 key，250 req/日）
FMP_API_KEY=

# FRED：利率/CPI/失业等宏观时间序列（免费 key）
FRED_API_KEY=

# Polygon（Massive 免费档）：行情/聚合，注意免费档无实时、期权逐笔受限
POLYGON_API_KEY=

# Discord Webhook：每 15 分钟把简报+信号推送到你自己的频道
# 建法：频道设置 → 整合 → Webhook → 新 Webhook → 复制 URL
DISCORD_WEBHOOK_URL=
